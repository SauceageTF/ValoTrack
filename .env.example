# Copy this file to .env and fill in the values.

# Discord bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# HenrikDev API key: https://api.henrikdev.xyz/dashboard/ -> API Keys -> Generate New Key
HENRIK_API_KEY=

# Optional: a server ID to sync slash commands to instantly while developing.
# Leave blank to register commands globally.
DEV_GUILD_ID=

# Optional tuning
DATABASE_PATH=valotrack.db
POLL_INTERVAL_MINUTES=3
# Stay under your HenrikDev key's per-minute limit (a basic key allows 30).
HENRIK_REQUESTS_PER_MINUTE=25
